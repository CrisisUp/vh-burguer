{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",            // <-- MUDOU AQUI
    "moduleResolution": "node16",  // <-- MUDOU AQUI
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "types": ["jest", "node"],

    "isolatedModules": true,          // ← ADICIONE
    "verbatimModuleSyntax": true       // ← ADICIONE (recomendado)
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}